title1 "Xanomeline Clinical Trial";
title2 "Integrated Safety Analysis";


/* Section 1: Safety population */

title3 "Safety Population by Actual Treatment";

proc freq data=work.safety_analysis;

    tables TRT01A;

run;


/* Section 2: Adverse event incidence */

title3 "Treatment-Emergent Adverse Events";

proc report data=work.ae_risk nowd;

    columns

        ENDPOINT

        TRT01A

        N_SUBJECTS

        N_EVENTS

        INCIDENCE

        INC_LCL

        INC_UCL;

    define ENDPOINT /
        display "Safety Endpoint"
        width=34
        format=$24.;

    define TRT01A /
        display "Treatment"
        width=24
        format=$24.;

    define N_SUBJECTS /
        display "N";

    define N_EVENTS /
        display "Affected Subjects";

    define INCIDENCE /
        display "Incidence"
        format=percent8.1;

    define INC_LCL /
        display "Lower 95% CI"
        format=percent8.1;

    define INC_UCL /
        display "Upper 95% CI"
        format=percent8.1;

run;


/* Section 3: Treatment comparisons generated by R */

title3 "Adverse Event Risk Compared with Placebo";

proc report data=work.ae_risk nowd;

    where not missing(RISK_DIFF);

    columns

        ENDPOINT

        TRT01A

        RISK_DIFF

        RD_LCL

        RD_UCL

        REL_RISK

        FISHER_P;

    define ENDPOINT /
        display "Safety Endpoint"
        width=34
        format=$24.;

    define TRT01A /
        display "Treatment"
        width=24
        format=$24.;

    define RISK_DIFF /
        display "Risk Difference"
        format=percent8.1;

    define RD_LCL /
        display "Lower 95% CI"
        format=percent8.1;

    define RD_UCL /
        display "Upper 95% CI"
        format=percent8.1;

    define REL_RISK /
        display "Relative Risk"
        format=8.2;

    define FISHER_P /
        display "Fisher p-value"
        format=pvalue8.4;

run;


/* Section 4: Features generated by Python */

title3 "Cardiovascular Safety Profile";

proc means data=work.safety_analysis

    n mean median std min max maxdec=2;

    class TRT01A;

    var

        SYSBP_BASE

        SYSBP_MAX_DROP

        SYSBP_MEAN_CHG

        SYSBP_SLOPE

        DIABP_MAX_DROP

        PULSE_MAX_RISE;

run;


/* Section 5: SAS visualization of Python results */

title3 "Maximum Systolic Blood Pressure Reduction";

proc sgplot data=work.safety_analysis;

    vbox SYSBP_MAX_DROP /
        category=TRT01A;

    yaxis label="Maximum SBP reduction (mmHg)";

    xaxis label="Actual Treatment";

run;


/* Section 6: Liver safety summary */

title3 "Liver Safety Categories Among Evaluable Subjects";

proc freq data=work.edish_safe;

    tables TRT01A*EDISHCAT /
        nocol nopercent;

run;


title;