proc r;
submit;


# --------------------------------------------------------
# 1. Load the visualization library.
# --------------------------------------------------------

library(ggplot2)


# --------------------------------------------------------
# 2. Read the statistical results generated by R
#    in the previous flow node.
# --------------------------------------------------------

risk <- sd2df(
    "ae_risk",
    "work"
)

names(risk) <- toupper(names(risk))


# Only active treatment comparisons
# have risk differences.

plot_data <- risk[
    !is.na(risk$RISK_DIFF),
]

if (nrow(plot_data) == 0) {
    stop("No treatment comparisons available.")
}


# Set the analytical order of endpoints.

plot_data$ENDPOINT <- factor(

    plot_data$ENDPOINT,

    levels = rev(c(

        "Any treatment-emergent AE",

        "Serious treatment-emergent AE",

        "Application-site reaction",

        "Syncope",

        "Dizziness"
    ))
)


# --------------------------------------------------------
# 3. Construct the forest plot.
# --------------------------------------------------------

p <- ggplot(

    plot_data,

    aes(
        x = RISK_DIFF,
        y = ENDPOINT,
        color = TRT01A
    )

) +

    # No difference compared with placebo.

    geom_vline(

        xintercept = 0,

        linetype = "dashed",

        color = "grey50"
    ) +

    # Confidence interval.

    geom_segment(

        aes(

            x = RD_LCL,

            xend = RD_UCL,

            yend = ENDPOINT
        ),

        linewidth = 0.8
    ) +

    # Risk difference estimate.

    geom_point(
        size = 3
    ) +

    # One panel per active treatment group.

    facet_wrap(
        ~TRT01A,
        ncol = 2
    ) +

    scale_x_continuous(

        labels = function(x) {
            paste0(
                round(x*100, 1),
                "%"
            )
        }
    ) +

    labs(

        title =
            "Treatment-emergent adverse event risk",

        subtitle =
            "Risk differences versus placebo with 95% confidence intervals",

        x = "Risk difference",

        y = NULL,

        caption =
            "Exploratory safety analysis - CDISC pilot study"
    ) +

    theme_minimal(
        base_size = 12
    ) +

    theme(

        legend.position = "none",

        panel.grid.major.y = element_blank(),

        plot.title = element_text(
            face = "bold"
        ),

        strip.text = element_text(
            face = "bold"
        )
    )


# --------------------------------------------------------
# 4. Display the R graph in SAS Studio Results.
# --------------------------------------------------------

rplot(p)

endsubmit;
run;